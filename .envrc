# wiki-client/.envrc
# Dev environment for wiki-client, reusing wiki-server's flake shell.
# This repo has no flake.nix; do not use `use flake .`.

set -euo pipefail

# Load standard nix-direnv integration
if ! command -v use >/dev/null 2>&1; then
  echo "direnv 'use' function not found; ensure nix-direnv is installed and hooked into direnv." >&2
  exit 1
fi

use flake ../wiki-server
